<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_toggle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_toggle_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@string/widget_toggle_description"
        android:src="@drawable/widget_toggle_off" />

    <TextView
        android:id="@+id/widget_toggle_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="@string/widget_toggle_off"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />
</LinearLayout>
